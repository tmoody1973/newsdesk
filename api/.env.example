# Newsdesk — copy to .env and fill in. .env is gitignored.

# Backblaze B2 (storage — required for every run)
# https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APP_KEY=
B2_REGION=us-east-005

# GMI Cloud (video: Seedance primary, Kling i2v fallback; also chat() for
# script generation, policy semantic check, and vision evaluation)
# https://console.gmicloud.ai/
GMI_API_KEY=

# ElevenLabs (narration, primary)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# LMNT (narration, fallback — CS-5 resilience run depends on this)
# https://app.lmnt.com/account
LMNT_API_KEY=

# Judge access code gating live generation on the public deploy (§13).
# Public visitors browse completed runs and run the CS-4 red-team battery
# without this; only paid generation requires it.
NEWSDESK_ACCESS_CODE=
